# Vercel import template for Paper-Format.
# Replace the two placeholders before importing; never commit real secrets.

SECRET_KEY=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
DATABASE_URL=REPLACE_WITH_ROTATED_NEON_POSTGRES_URL
COOKIE_SECURE=true
GOOGLE_OAUTH_CLIENT_ID=REPLACE_WITH_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com

# For Vercel Blob, connect a PRIVATE Blob store to this project. Vercel supplies
# BLOB_STORE_ID and VERCEL_OIDC_TOKEN automatically. The alternative is private S3:
# S3_BUCKET=REPLACE_WITH_PRIVATE_BUCKET_NAME
# S3_ACCESS_KEY_ID=REPLACE_WITH_STORAGE_ACCESS_KEY
# S3_SECRET_ACCESS_KEY=REPLACE_WITH_STORAGE_SECRET_KEY
# S3_ENDPOINT_URL=REPLACE_WITH_S3_ENDPOINT_URL
# S3_REGION=auto

# Optional: enable public Google Drive imports.
# GOOGLE_API_KEY=REPLACE_WITH_GOOGLE_API_KEY

# Optional: enable outbound email notifications.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=REPLACE_WITH_SMTP_USERNAME
# SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
# SMTP_FROM=no-reply@example.com
