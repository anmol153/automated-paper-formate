# syntax=docker/dockerfile:1

FROM node:22-slim AS frontend-build
WORKDIR /build
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
RUN npm run build

FROM python:3.13-slim AS deps
WORKDIR /deps
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"
COPY backend/requirements.txt ./
RUN pip install --no-cache-dir --upgrade pip \
 && pip install --no-cache-dir -r requirements.txt

FROM python:3.13-slim AS runtime
ENV PYTHONUNBUFFERED=1 \
    PATH="/opt/venv/bin:$PATH"
COPY --from=deps /opt/venv /opt/venv
WORKDIR /app/backend
COPY backend/app ./app
COPY --from=frontend-build /build/dist ./static/frontend
EXPOSE 80
CMD ["sh", "-c", "set -e; export WORKFLOW_DB_PATH=\"${WORKFLOW_DB_PATH:-/tmp/paper-format/platform.db}\"; export SUBMISSION_FILE_DIR=\"${SUBMISSION_FILE_DIR:-/tmp/paper-format/submissions}\"; if [ -n \"${DATABASE_URL:-}${POSTGRES_URL:-}\" ]; then python -m app.storage.migrate --initialize-shared; else mkdir -p \"$(dirname \"$WORKFLOW_DB_PATH\")\"; python -m app.storage.migrate --target \"$WORKFLOW_DB_PATH\" --initialize-empty; fi; mkdir -p \"$SUBMISSION_FILE_DIR\"; exec uvicorn app.main:app --host 0.0.0.0 --port ${PORT:-80}"]
